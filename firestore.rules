rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      // Set via Cloud Functions `grantAdminClaim` or scripts/setAdminClaim.mjs.
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---------------------------------------------------------------
    // Users: profile + private subcollections (attempts, bookmarks).
    // A user can read/update their own profile, but cannot set
    // `premium`/`premiumExpiry` themselves — only the payment Cloud
    // Functions (which run as admin, bypassing rules) may do that.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.premium == false
        && request.resource.data.get('premiumExpiry', null) == null;
      allow update: if isOwner(uid)
        && request.resource.data.premium == resource.data.premium
        && request.resource.data.premiumExpiry == resource.data.premiumExpiry;
      allow delete: if false;

      match /attempts/{attemptId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /bookmarks/{bookmarkId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // ---------------------------------------------------------------
    // Payment records: written only by Cloud Functions (admin SDK,
    // bypasses rules). Owners may read their own payment history.
    // ---------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Content: modules + questions. Anyone can read published questions
    // (guest browsing works without login); only admins can write, and
    // only admins can read drafts (so unpublished content isn't public).
    // ---------------------------------------------------------------
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Block definitions (Block -> Module -> Subject curriculum tree).
    match /block_definitions/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subheadings: 4th tier of the hierarchy (Block -> Module -> Subject -> Subheading).
    match /subheadings/{subheadingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Lectures: same access pattern as questions — guests/students can read only
    // published lectures, admins can read/write everything (drafts included).
    match /lectures/{lectureId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
