rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      // Set via Cloud Functions `grantAdminClaim` or scripts/setAdminClaim.mjs.
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---------------------------------------------------------------
    // Users: profile + private subcollections (attempts, bookmarks).
    // A user can read/update their own profile, but cannot set
    // `premium`/`premiumExpiry` themselves — only the payment Cloud
    // Functions (which run as admin, bypassing rules) may do that.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.premium == false
        && request.resource.data.get('premiumExpiry', null) == null;
      // Owners can update their own profile (streak, daily goal, etc.) but
      // may never change their own premium/premiumExpiry/unlockedBlocks/
      // testSeriesUnlocked — those are only ever written by the payment
      // Cloud Functions or by an admin from the "Manage Access" admin tab
      // (bypasses these four fields' owner restriction below).
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.premium == resource.data.premium
        && request.resource.data.premiumExpiry == resource.data.premiumExpiry
        && request.resource.data.get('unlockedBlocks', null) == resource.data.get('unlockedBlocks', null)
        && request.resource.data.get('testSeriesUnlocked', null) == resource.data.get('testSeriesUnlocked', null));
      allow delete: if false;

      match /attempts/{attemptId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /bookmarks/{bookmarkId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // ---------------------------------------------------------------
    // Payment records: written only by Cloud Functions (admin SDK,
    // bypasses rules). Owners may read their own payment history.
    // ---------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Content: modules + questions. Anyone can read published questions
    // (guest browsing works without login); only admins can write, and
    // only admins can read drafts (so unpublished content isn't public).
    // ---------------------------------------------------------------
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Block definitions (Block -> Module -> Subject curriculum tree).
    match /block_definitions/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subheadings: 4th tier of the hierarchy (Block -> Module -> Subject -> Subheading).
    match /subheadings/{subheadingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Lectures: same access pattern as questions — guests/students can read only
    // published lectures, admins can read/write everything (drafts included).
    match /lectures/{lectureId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Past Papers: same access pattern as questions/lectures — guests/students
    // can read only published past papers, admins can read/write everything
    // (drafts included).
    match /past_papers/{paperId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Test Sessions: curated MCQ tests built in the admin "Test Sessions" tab.
    // Students may only read published tests (their query must filter on
    // status == 'published'); admins can read/write everything, drafts included.
    match /test_sessions/{testId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Mock Tests (Block 1-15 -> Mock Test 1, 2...): same access pattern as test_sessions —
    // students read only published ones (query must filter status == 'published'),
    // admins read/write everything.
    match /mock_tests/{mockId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Student reviews, sent from the end of a practice session / past paper / test.
    // Any signed-in student can CREATE one (always un-featured, only their own uid).
    // Only reviews an admin marked `featured` are publicly readable (homepage shows
    // up to 5 — the query must filter featured == true); admins read, feature, delete.
    // ---------------------------------------------------------------
    match /reviews/{reviewId} {
      allow get, list: if resource.data.featured == true || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.featured == false
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.source in ['mcq', 'past_paper', 'test', 'mock']
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'rating', 'text', 'source', 'context', 'featured', 'featuredAt', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Test Series leaderboard + retake cooldown. One doc per (test, student):
    // test_leaderboard/{testId}_{uid}. Any signed-in student can read the board.
    // `startedAt` must be the server time, and a student can only start the same
    // test again 2 hours after their previous start. The score fields can be
    // updated by the owner without touching `startedAt`. Admins can delete an
    // entry (that also resets the student's cooldown for that test).
    // ---------------------------------------------------------------
    match /test_leaderboard/{entryId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && entryId == request.resource.data.testId + '_' + request.auth.uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.completed == false
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.college is string
        && request.resource.data.college.size() <= 100;

      allow update: if isOwner(resource.data.uid) && (
        // (a) starting a new attempt: only after the 2-hour cooldown
        (
          request.resource.data.startedAt == request.time
          && request.time >= resource.data.startedAt + duration.value(2, 'h')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['startedAt', 'displayName', 'college', 'testName', 'attempts'])
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.college.size() <= 100
        )
        // (b) saving a finished attempt's score: startedAt must stay as-is
        || (
          request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.correct <= request.resource.data.total
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['completed', 'correct', 'total', 'scorePct', 'timeTakenSec'])
        )
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // App-wide settings, e.g. settings/freeBlocks ({ blocks: number[] }),
    // which Blocks are free for everyone, or settings/testSeriesAccess
    // ({ enabled: boolean }), whether students can access Test Series.
    // Readable by anyone (guests need it to know what's unlocked), writable
    // only by admins — edited from the "Manage Access" tab.
    // ---------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Site visit counters (see src/services/siteStats.ts). Writes don't
    // require auth (guests/students visiting the site trigger these), but
    // each write may only ever move a counter forward by exactly 1 — never
    // set it to an arbitrary value — and only an admin can read the totals
    // shown in the "Site Visits" admin tab.
    // ---------------------------------------------------------------
    match /siteStats/{docId} {
      allow get, list: if isAdmin();
      allow create: if docId == 'summary' && request.resource.data.totalVisits == 1;
      allow update: if docId == 'summary'
        && request.resource.data.totalVisits == resource.data.totalVisits + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits', 'updatedAt']);
      allow delete: if false;
    }

    match /siteStats_daily/{dayId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt', 'date']);
      allow delete: if false;
    }
  }
}
